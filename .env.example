# ==============================================================================
# TitanNova Fit — Exemplo de Configuração de Ambiente (.env.example)
# NUNCA insira chaves secretas ou credenciais reais de produção neste arquivo.
# ==============================================================================

# Supabase (Client & Server)
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=seu_anon_public_key_aqui

# Supabase Server-Only (Exclusivo para Serverless APIs na Vercel — NUNCA expor no frontend)
SUPABASE_SERVICE_ROLE_KEY=seu_service_role_secret_key_aqui

# Banco Local (Modo Offline / App Mobile)
DB_NAME=titannovafit_offline.db
DB_VERSION=1

# Configurações do Aplicativo
ENABLE_ANALYTICS=false
DEFAULT_REST_SECONDS=60
DEFAULT_UNIT=kg
